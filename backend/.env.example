# Server Environment Configuration

PORT=5000
MONGODB_URI=mongodb://localhost:27017/attendance-app
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── GOOGLE OAUTH CONFIGURATION ───
# Paste your Google Client ID from Google Cloud Console / Firebase Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ─── EMAIL VERIFICATION (SMTP / BREVO) ───
# For Brevo (formerly Sendinblue) or standard SMTP:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_api_key_or_smtp_password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=AttendanceApp

# ─── SMS OTP CONFIGURATION (TWILIO) ───
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE=+1234567890
